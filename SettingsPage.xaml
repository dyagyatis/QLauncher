<Page x:Class="MinecraftLauncher.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Настройки" FontFamily="Inter">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Button HorizontalAlignment="Left" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="40" Height="40" Style="{StaticResource DarkButtonStyle}" Click="BackButton_Click" ToolTip="Назад"/>
            <TextBlock Text="Настройки" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" CornerRadius="15" Padding="25">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="ОСНОВНЫЕ" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

                    <CheckBox x:Name="CloseOnLaunchCheck" Content="Закрывать лаунчер при запуске игры" Style="{StaticResource CustomCheckBox}"/>
                    <CheckBox x:Name="DiscordRpcCheck" Content="Показывать статус в Discord (RPC)" Style="{StaticResource CustomCheckBox}"/>
                    <CheckBox x:Name="UiSoundsCheck" Content="Включить звуковые эффекты интерфейса (UI Sounds)" Style="{StaticResource CustomCheckBox}"/>
                    <CheckBox x:Name="HideServerIpCheck" Content="Скрывать IP серверов в Discord" Style="{StaticResource CustomCheckBox}"/>
                    <CheckBox x:Name="AutoAddServersCheck" Content="Автоматически добавлять сервера SCRAFT" Style="{StaticResource CustomCheckBox}"/>

                    <Border Height="1" Background="{DynamicResource HoverOverlayBrush}" Margin="0,20"/>

                    <TextBlock Text="JAVA И ПАМЯТЬ" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="Выделение оперативной памяти (МБ)" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="RamSlider" Minimum="1024" Maximum="16384" TickFrequency="1024" IsSnapToTickEnabled="True" ValueChanged="RamSlider_ValueChanged" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBox x:Name="RamTextBox" Grid.Column="1" Text="4096" Style="{StaticResource CustomTextBoxStyle}" Height="35" TextAlignment="Center" Padding="0" IsReadOnly="True" FontSize="13"/>
                    </Grid>

                    <TextBlock Text="Свой путь к Java (оставьте пустым для авто-скачивания)" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="JavaPathBox" Style="{StaticResource CustomTextBoxStyle}" Height="40" Margin="0,0,10,0" FontSize="13"/>
                        <Button Grid.Column="1" Content="Обзор..." Width="100" Height="40" Style="{StaticResource DarkButtonStyle}" Click="BrowseJava_Click" FontSize="13"/>
                    </Grid>

                    <TextBlock Text="Пресет оптимизации JVM (устранение лагов)" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,5"/>
                    <ComboBox x:Name="JvmPresetBox" Height="40" Style="{StaticResource CustomComboBoxStyle}" Margin="0,0,0,15" Padding="12,0,0,0" VerticalContentAlignment="Center" FontSize="13">
                        <ComboBoxItem Content="Стандартный (G1GC)" Tag="default" IsSelected="True"/>
                        <ComboBoxItem Content="Aikar's Flags (Макс. FPS и плавность)" Tag="aikar"/>
                        <ComboBoxItem Content="Low Latency (ZGC / Shenandoah)" Tag="zgc_shenandoah"/>
                    </ComboBox>

                    <Border Height="1" Background="{DynamicResource HoverOverlayBrush}" Margin="0,20"/>

                    <TextBlock Text="ЭКРАН И ГРАФИКА" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,15"/>

                    <CheckBox x:Name="FullScreenCheck" Content="Запускать в полном экране (Fullscreen)" Style="{StaticResource CustomCheckBox}"/>

                    <TextBlock Text="Разрешение окна игры (ширина х высота)" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,10,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ResWidthBox" Text="1920" Style="{StaticResource CustomTextBoxStyle}" Height="40" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="x" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                        <TextBox x:Name="ResHeightBox" Grid.Column="2" Text="1080" Style="{StaticResource CustomTextBoxStyle}" Height="40" FontSize="13"/>
                    </Grid>

                    <TextBlock Text="Собственные фоновые обои лаунчера" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WallpaperPathBox" Style="{StaticResource CustomTextBoxStyle}" Height="40" Margin="0,0,10,0" IsReadOnly="True" FontSize="13"/>
                        <Button Grid.Column="1" Content="Выбрать..." Width="110" Height="40" Style="{StaticResource DarkButtonStyle}" Click="BrowseWallpaper_Click" Margin="0,0,8,0" FontSize="13"/>
                        <Button Grid.Column="2" Content="Сбросить" Width="100" Height="40" Style="{StaticResource DarkButtonStyle}" Click="ResetWallpaper_Click" FontSize="13"/>
                    </Grid>

                    <TextBlock Text="АКЦЕНТНЫЙ ЦВЕТ ТЕМЫ" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="💙 Sapphire" Click="ThemeAccent_Click" Tag="sapphire" Height="36" Padding="14,0" Margin="0,0,8,0" Style="{StaticResource DarkButtonStyle}"/>
                        <Button Content="💜 Amethyst" Click="ThemeAccent_Click" Tag="purple" Height="36" Padding="14,0" Margin="0,0,8,0" Style="{StaticResource DarkButtonStyle}"/>
                        <Button Content="🟢 Emerald" Click="ThemeAccent_Click" Tag="emerald" Height="36" Padding="14,0" Margin="0,0,8,0" Style="{StaticResource DarkButtonStyle}"/>
                        <Button Content="🩷 Rose" Click="ThemeAccent_Click" Tag="rose" Height="36" Padding="14,0" Margin="0,0,8,0" Style="{StaticResource DarkButtonStyle}"/>
                        <Button Content="🟡 Amber" Click="ThemeAccent_Click" Tag="amber" Height="36" Padding="14,0" Style="{StaticResource DarkButtonStyle}"/>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource HoverOverlayBrush}" Margin="0,20"/>

                    <TextBlock Text="ОБСЛУЖИВАНИЕ ДИСКА" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="CacheInfoText" Text="Размер кэша и логов: вычисляется..." Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"/>
                            <TextBlock Text="Удаляет временные файлы, кэш скинов и старые журналы" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Очистить кэш" Click="CleanCache_Click" Width="100" Height="40" Style="{StaticResource DarkButtonStyle}" FontSize="13"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource HoverOverlayBrush}" Margin="0,20"/>

                    <TextBlock Text="ВАШИ АККАУНТЫ" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,5"/>
                    <Border Background="{DynamicResource HoverOverlayBrush}" CornerRadius="10" Margin="0,0,0,15" Padding="5">
                        <ItemsControl x:Name="AccountsListControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid x:Name="MsLogo" Width="14" Height="14" Margin="10,0,10,0" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Fill="#F25022" Margin="0,0,1,1"/>
                                            <Rectangle Grid.Column="1" Fill="#7FBA00" Margin="1,0,0,1"/>
                                            <Rectangle Grid.Row="1" Fill="#00A4EF" Margin="0,1,1,0"/>
                                            <Rectangle Grid.Row="1" Grid.Column="1" Fill="#FFB900" Margin="1,1,0,0"/>
                                        </Grid>

                                        <TextBlock Grid.Column="1" Text="{Binding Nickname}" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" FontSize="13"/>
                                        <Button Grid.Column="2" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Width="30" Height="30" Style="{StaticResource DarkButtonStyle}" Foreground="#E81123" Click="DeleteAccount_Click" Tag="{Binding Nickname}"/>
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding AccessToken}" Value="offline">
                                            <Setter TargetName="MsLogo" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Text="Оффлайн аккаунт (Пиратка)" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OfflineNicknameBox" Style="{StaticResource CustomTextBoxStyle}" Height="40" Margin="0,0,10,0" FontSize="13"/>
                        <Button Grid.Column="1" Content="Добавить ник" Width="140" Height="40" Style="{StaticResource DarkButtonStyle}" Click="AddOfflineAccount_Click" FontSize="13"/>
                    </Grid>

                    <TextBlock Text="Лицензия (Для официальных серверов)" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,5"/>
                    <Button Content="Добавить аккаунт Microsoft" Width="240" Height="40" HorizontalAlignment="Left" Style="{StaticResource PlayButtonStyle}" Click="AddMicrosoftAccount_Click" Margin="0,0,0,25" FontSize="13"/>

                    <Border Height="1" Background="{DynamicResource HoverOverlayBrush}" Margin="0,0,0,20"/>

                    <TextBlock Text="ДАННЫЕ" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Экспорт" Width="110" Height="40" Style="{StaticResource DarkButtonStyle}" Margin="0,0,10,0" Click="ExportSettings_Click" FontSize="13"/>
                        <Button Content="Импорт" Width="110" Height="40" Style="{StaticResource DarkButtonStyle}" Margin="0,0,10,0" Click="ImportSettings_Click" FontSize="13"/>
                        <Button Content="Сбросить" Width="110" Height="40" Style="{StaticResource DarkButtonStyle}" Foreground="#E81123" Click="ResetSettings_Click" FontSize="13"/>
                    </StackPanel>

                    <Button Content="Сохранить настройки" Width="200" Height="45" HorizontalAlignment="Right" Margin="0,20,0,0" Style="{StaticResource PlayButtonStyle}" Background="#4CAF50" Click="SaveButton_Click" FontSize="14"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>