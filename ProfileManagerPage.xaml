<Page x:Class="MinecraftLauncher.ProfileManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление сборкой" Background="Transparent"
      FontFamily="Inter">

    <Page.Resources>
        <Style x:Key="TabRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource InputNicknameBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="16" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Style="{DynamicResource DarkButtonStyle}" Width="36" Height="36" Click="BackButton_Click" ToolTip="Назад"/>
                            <TextBlock x:Name="TitleText" Text="Управление сборкой" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="PlaytimeText" Text="Время в игре: 0 ч • Запусков: 0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="51,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="➕ Новая сборка" Click="CreatePack_Click" Height="36" Padding="14,0" Margin="0,0,8,0" Style="{DynamicResource DarkButtonStyle}" FontSize="13" ToolTip="Создать новую сборку"/>
                        <Button Content="📦 Экспорт Zip" Click="ExportPackZip_Click" Height="36" Padding="14,0" Margin="0,0,8,0" Style="{DynamicResource DarkButtonStyle}" FontSize="13" ToolTip="Экспортировать выбранную сборку в Zip"/>
                        <Button Content="🔗 Ярлык" Click="CreateShortcut_Click" Height="36" Padding="14,0" Margin="0,0,8,0" Style="{DynamicResource DarkButtonStyle}" FontSize="13" ToolTip="Создать ярлык на рабочий стол"/>
                        <Button Content="🗑️ Удалить" Click="DeletePack_Click" Height="36" Padding="14,0" Foreground="#FF6363" Style="{DynamicResource DarkButtonStyle}" FontSize="13" ToolTip="Удалить текущую выбранную сборку"/>
                    </StackPanel>
                </Grid>

                <!-- Navigation Tabs -->
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <RadioButton x:Name="TabModsRadio" Content="Установленные моды" IsChecked="True" Style="{StaticResource TabRadioButtonStyle}" Margin="0,0,10,0" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabWorldsRadio" Content="Миры и бэкапы" Style="{StaticResource TabRadioButtonStyle}" Checked="Tab_Checked"/>
                    </StackPanel>
                </Grid>

                <!-- MODS VIEW -->
                <Grid x:Name="ModsView" Grid.Row="2" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12" HorizontalAlignment="Right">
                        <Button Content="📁 Открыть папку mods" Click="OpenModsFolder_Click" Height="36" Padding="14,0" Style="{DynamicResource DarkButtonStyle}" FontSize="13"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <TextBlock x:Name="NoModsText" Text="Моды в этой сборке пока не найдены. Вы можете перетащить .jar файлы сюда или загрузить их через Каталог модов." 
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Visibility="Collapsed"/>
                            
                            <ItemsControl x:Name="LocalModsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource HoverOverlayBrush}" CornerRadius="10" Margin="0,0,0,8" Padding="14,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="12" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <Button Grid.Column="1" Content="{Binding ActionText}" Tag="{Binding FullPath}" Click="ToggleMod_Click" Margin="0,0,8,0" Height="32" Padding="12,0" Style="{DynamicResource DarkButtonStyle}" FontSize="13"/>
                                                <Button Grid.Column="2" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Tag="{Binding FullPath}" Click="DeleteMod_Click" Height="32" Width="36" Foreground="#FF6363" Style="{DynamicResource DarkButtonStyle}" ToolTip="Удалить мод"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- WORLDS VIEW -->
                <Grid x:Name="WorldsView" Grid.Row="2" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12" HorizontalAlignment="Right">
                        <Button Content="📁 Открыть папку saves" Click="OpenSavesFolder_Click" Height="36" Padding="14,0" Style="{DynamicResource DarkButtonStyle}" FontSize="13"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <TextBlock x:Name="NoWorldsText" Text="Сохранения миров не найдены. Запустите игру, чтобы создать свой первый мир!" 
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Visibility="Collapsed"/>
                            
                            <ItemsControl x:Name="WorldsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource HoverOverlayBrush}" CornerRadius="10" Margin="0,0,0,10" Padding="14,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="6" Margin="0,0,12,0" ClipToBounds="True" Background="#111">
                                                    <Image Source="{Binding IconPath}" Stretch="UniformToFill"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding WorldName}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock Text="{Binding LastPlayedText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Создать Zip-бэкап" Tag="{Binding FullPath}" Click="BackupWorld_Click" Height="32" Padding="12,0" Margin="0,0,8,0" Style="{DynamicResource DarkButtonStyle}" FontSize="13"/>
                                                    <Button Content="Удалить" Tag="{Binding FullPath}" Click="DeleteWorld_Click" Height="32" Padding="12,0" Foreground="#FF6363" Style="{DynamicResource DarkButtonStyle}" FontSize="13"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
