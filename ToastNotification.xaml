<UserControl x:Class="MinecraftLauncher.ToastNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Inter">
    <Border x:Name="ToastBorder" Background="#242432" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" HorizontalAlignment="Right" MaxWidth="360">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" Opacity="0.4" BlurRadius="12"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="IconText" Grid.Column="0" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Уведомление" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" FontSize="13"/>
                <TextBlock x:Name="MessageText" Text="Описание..." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
