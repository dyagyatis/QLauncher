<Page x:Class="MinecraftLauncher.Views.Pages.ScreenshotsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:MinecraftLauncher.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance vm:ScreenshotsViewModel}"
      Title="Галерея скриншотов" Background="Transparent"
      FontFamily="Inter">

    <Grid Margin="20">
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="16" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Style="{DynamicResource DarkButtonStyle}" Width="36" Height="36" Click="BackButton_Click" ToolTip="Назад"/>
                        <TextBlock Text="Галерея скриншотов Minecraft" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="Открыть папку" Command="{Binding OpenFolderCommand}" Padding="12,6" Style="{DynamicResource DarkButtonStyle}"/>
                </Grid>

                <Grid Grid.Row="1">
                    <TextBlock Text="Скриншоты пока не найдены..." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasScreenshots}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Screenshots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="240" Height="170" Margin="0,0,15,15" Background="#1A1A22" CornerRadius="10" ClipToBounds="True" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="35"/>
                                            </Grid.RowDefinitions>

                                            <Button Grid.Row="0" Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                                                    Command="{Binding DataContext.OpenPreviewCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding FilePath}">
                                                <Image Source="{Binding FilePath}" Stretch="UniformToFill"/>
                                            </Button>

                                            <Border Grid.Row="1" Background="#22222E" Padding="8,0">
                                                <Grid VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" Foreground="#CCCCCC" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" 
                                                                Command="{Binding DataContext.CopyImageCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                CommandParameter="{Binding FilePath}" Width="26" Height="26" Style="{DynamicResource DarkButtonStyle}" ToolTip="Копировать" Margin="0,0,4,0"/>
                                                        <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" 
                                                                Command="{Binding DataContext.DeleteImageCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                CommandParameter="{Binding FilePath}" Width="26" Height="26" Foreground="#FF5555" Style="{DynamicResource DarkButtonStyle}" ToolTip="Удалить"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Background="#EE000000">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPreviewVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding ClosePreviewCommand}"/>
                        </Grid.InputBindings>
                        <Border Margin="40" CornerRadius="12" ClipToBounds="True" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="{Binding PreviewImage}" Stretch="Uniform" MaxHeight="600" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
